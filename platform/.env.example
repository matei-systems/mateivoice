# ─────────────────────────────────────────────────────────────────────────────
# Project Aurora – Beispielkonfiguration (KEINE echten Geheimnisse eintragen!)
# Kopieren:  cp .env.example .env   und Werte anpassen.
# Geheimnisse gehören in einen Secret-Manager bzw. die Umgebung des Servers –
# niemals ins Repository, in Logs oder in die Dokumentation.
# Geheimnisse erzeugen:
#   AUTH_SECRET:          openssl rand -base64 48
#   DATA_ENCRYPTION_KEY:  openssl rand -base64 32
#   JOBS_SECRET:          openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production
# In production verweigert die App den Start, solange Testmodus, Sandbox- oder Mock-Anbieter aktiv sind.
APP_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL 16. Entwicklungsskripte laufen nur gegen Datenbanken mit Suffix _dev.
DATABASE_URL=postgres://aurora:CHANGE_ME@localhost:5432/aurora_dev

# [GEHEIM] Mindestens 32 Zeichen. Pseudonymisierte IP-Hashes, Signaturen (Sandbox-Webhooks, Abmeldelinks, Mock-Token).
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# [GEHEIM] Base64-kodierter 32-Byte-Schlüssel (AES-256-GCM) für TOTP-Geheimnisse und IBANs.
DATA_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# Testmodus: Testmünzen, Sandbox-/Mock-Anbieter, Entwicklungs-Mailbox. In Produktion verboten.
TEST_MODE=true

# ── E-Mail ────────────────────────────────────────────────────────────────────
# dev-outbox (nur speichern, /dev/mailbox) | smtp | disabled
EMAIL_PROVIDER=dev-outbox
# Absenderadresse einer EIGENEN, beim Mail-Dienst verifizierten Domain (SPF/DKIM/DMARC). Nichts erfinden.
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
# true nur bei implizitem TLS (Port 465); sonst STARTTLS (in Produktion erzwungen)
SMTP_SECURE=false
SMTP_USER=
# [GEHEIM]
SMTP_PASSWORD=

# ── Zahlungen ────────────────────────────────────────────────────────────────
# simulated (Sandbox, nur Testmünzen) | verotel | none
# Echtzahlungen bleiben unabhängig davon gesperrt (realCoinsEnabled() === false),
# bis der Anbieter dieses Geschäftsmodell schriftlich freigegeben hat (docs/PAYMENT-PROVIDERS.md).
PAYMENT_PROVIDER=simulated
VEROTEL_SHOP_ID=
# [GEHEIM]
VEROTEL_SIGNATURE_KEY=
VEROTEL_START_URL=https://secure.verotel.com/startorder

# Auszahlungen: sandbox (simuliert, nur Testmünzen) | none
PAYOUT_PROVIDER=sandbox

# ── Video / Streaming ────────────────────────────────────────────────────────
# mock (kein Video) | livekit | none
VIDEO_PROVIDER=mock
# z. B. wss://livekit.eure-domain.example (eigener Server oder LiveKit Cloud – Nutzungsbedingungen prüfen!)
LIVEKIT_URL=
LIVEKIT_API_KEY=
# [GEHEIM] Verlässt nie den Server; der Browser erhält nur kurzlebige Raum-Token.
LIVEKIT_API_SECRET=

# ── Identität / Alter ────────────────────────────────────────────────────────
# mock (kann nie „verifiziert“ erzeugen) | none
IDENTITY_PROVIDER=mock

# ── Speicher ─────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# ── Hintergrundjobs ──────────────────────────────────────────────────────────
# [GEHEIM] Schützt POST /api/jobs/run (Sitzungen aufräumen, E-Mail-Wiederholungen, Aufbewahrung).
# Leer = Endpunkt deaktiviert. Aufruf z. B. minütlich: curl -X POST -H "Authorization: Bearer $JOBS_SECRET" …
JOBS_SECRET=

# Hinweis: Provision (Standard 25 % Plattform / 75 % Model), Auszahlungsregeln, Kauflimits,
# Funktionen, Wartungsmodus, Länder/Altersprüfung usw. werden im Mitarbeiterbereich unter
# „Einstellungen“ gepflegt (mit Begründung und Historie) – nicht über die Umgebung.

LOG_LEVEL=info

# Arbeitsname der Plattform (öffentlich, wird beim Build eingebettet).
NEXT_PUBLIC_PLATFORM_NAME=Project Aurora

# Datenschutzfreundlich: Next.js-Telemetrie deaktivieren.
NEXT_TELEMETRY_DISABLED=1

# ── Nur Entwicklung (pnpm db:seed). Niemals in Produktion verwenden. ─────────
SEED_DEFAULT_PASSWORD=CHANGE_ME_dev_only_password
# Optional: feste TOTP-Geheimnisse (Base32) für Seed-Mitarbeiterkonten. Leer = zufällig, einmal ausgegeben.
SEED_ADMIN_TOTP_SECRET=
SEED_MODERATOR_TOTP_SECRET=
SEED_SUPPORT_TOTP_SECRET=
SEED_FINANCE_TOTP_SECRET=
