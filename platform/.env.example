# ─────────────────────────────────────────────────────────────────────────────
# Project Aurora – Beispielkonfiguration (KEINE echten Geheimnisse eintragen!)
# Kopieren:  cp .env.example .env   und Werte anpassen.
# Geheimnisse erzeugen:
#   AUTH_SECRET:          openssl rand -base64 48
#   DATA_ENCRYPTION_KEY:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production
# In production verweigert die App den Start, solange Testmodus oder Mock-Anbieter aktiv sind.
APP_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL 16 (lokal). Entwicklungsskripte laufen nur gegen Datenbanken mit Suffix _dev.
DATABASE_URL=postgres://aurora:CHANGE_ME@localhost:5432/aurora_dev

# Mindestens 32 Zeichen. Wird für pseudonymisierte IP-Hashes, Rate-Limit-Schlüssel und Mock-Signaturen genutzt.
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# Base64-kodierter 32-Byte-Schlüssel (AES-256-GCM) für TOTP-Geheimnisse.
DATA_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# Testmodus: simulierte Münzen, Mock-Anbieter, Entwicklungs-Mailbox. In Produktion verboten.
TEST_MODE=true

# Anbieter (austauschbar). Echte Anbieter erst nach Prüfung und schriftlicher Freigabe anbinden.
EMAIL_PROVIDER=dev-outbox       # dev-outbox | disabled
PAYMENT_PROVIDER=simulated      # simulated | none
PAYOUT_PROVIDER=none            # none
VIDEO_PROVIDER=mock             # mock | none
IDENTITY_PROVIDER=mock          # mock | none
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Vorläufige Plattformprovision in Basispunkten (3000 = 30 %).
PLATFORM_COMMISSION_BPS=3000

LOG_LEVEL=info

# Arbeitsname der Plattform (öffentlich, wird beim Build eingebettet).
NEXT_PUBLIC_PLATFORM_NAME=Project Aurora

# Datenschutzfreundlich: Next.js-Telemetrie deaktivieren.
NEXT_TELEMETRY_DISABLED=1

# Nur für `pnpm db:seed` (Entwicklung). Niemals in Produktion verwenden.
SEED_DEFAULT_PASSWORD=CHANGE_ME_dev_only_password
# Optional: festes TOTP-Geheimnis (Base32) für das Seed-Admin-Konto. Leer = wird zufällig erzeugt und einmal ausgegeben.
SEED_ADMIN_TOTP_SECRET=
